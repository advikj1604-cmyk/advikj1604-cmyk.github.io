---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Live Night Sky — ${SITE_TITLE}`}
			description="An interactive real-time planetarium. Explore stars, constellations, planets, and deep-sky objects from your location."
		/>
		<!-- Astronomy Engine: same accurate engine used on the Tonight's Sky page -->
		<script src="https://cdn.jsdelivr.net/npm/astronomy-engine@2.1.19/astronomy.browser.js" is:inline></script>
		<style is:global>
			body { margin: 0; padding: 0; }
			.sky-page { width: 100%; max-width: calc(100% - 2em); margin: auto; padding: 2em 1em 0; }
			.sky-header { margin-bottom: 1rem; }
			.sky-header h1 { font-size: 1.6rem; margin: 0 0 0.25rem 0; color: rgb(var(--black)); }
			.sky-header p { font-size: 0.9rem; color: rgb(var(--gray)); margin: 0; line-height: 1.5; }
			.sky-header p a { color: var(--accent); text-decoration: none; }
			.sky-header p a:hover { text-decoration: underline; }
			.sky-header-row { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
			#btn-change {
				display: none; font-size: 0.78rem; color: var(--accent);
				background: none; border: none; cursor: pointer; font-family: inherit; padding: 0;
			}
			#btn-change:hover { text-decoration: underline; }

			#location-prompt {
				width: 100%; height: 82vh; min-height: 500px;
				border-radius: 8px; border: 1px solid rgba(var(--gray-light),1);
				box-shadow: var(--box-shadow); margin-top: 1rem;
				display: flex; flex-direction: column; align-items: center;
				justify-content: center; gap: 1.2rem;
				background: #020b18; text-align: center; padding: 2rem;
			}
			.prompt-icon { font-size: 3rem; line-height: 1; }
			#location-prompt h2 { color: #e8eaf6; font-size: 1.3rem; margin: 0; }
			#location-prompt p { color: #7986a8; font-size: 0.88rem; max-width: 360px; line-height: 1.6; margin: 0; }
			.city-input-row { display: flex; gap: 0.5rem; width: 100%; max-width: 400px; }
			#city-input {
				flex: 1; padding: 0.6rem 0.9rem; border-radius: 4px;
				border: 1px solid #2a3550; background: #0d1a2e; color: #e8eaf6;
				font-size: 0.95rem; font-family: inherit; outline: none; transition: border-color 0.15s;
			}
			#city-input:focus { border-color: var(--accent); }
			#city-input::placeholder { color: #3d4f6e; }
			#btn-go {
				background: var(--accent); color: white; border: none;
				padding: 0.6rem 1.3rem; border-radius: 4px; font-size: 0.9rem;
				font-family: inherit; cursor: pointer; transition: opacity 0.15s; white-space: nowrap;
			}
			#btn-go:hover { opacity: 0.85; }
			#btn-go:disabled { opacity: 0.5; cursor: not-allowed; }
			#location-status { font-size: 0.82rem; color: #556080; min-height: 1.2em; }
			#location-status.error { color: #e05555; }
			#location-status.success { color: #5a9e6f; }

			.sky-frame-wrap {
				width: 100%; height: 82vh; min-height: 500px;
				border-radius: 8px; overflow: hidden;
				border: 1px solid rgba(var(--gray-light),1);
				box-shadow: var(--box-shadow); margin-top: 1rem;
				position: relative; display: none;
			}
			.sky-frame-wrap iframe {
				position: absolute; top: 0; left: -315px;
				width: calc(100% + 315px); height: 100%;
				border: none; display: block;
			}

			#visible-panel {
				position: absolute; bottom: 0; left: 0;
				width: 480px; height: 208px;
				background: rgba(8, 12, 24, 0.98);
				border-top: 1px solid rgba(255,255,255,0.1);
				border-right: 1px solid rgba(255,255,255,0.08);
				border-top-right-radius: 10px;
				z-index: 10; display: flex; flex-direction: column; overflow: hidden;
			}
			.vp-header {
				display: flex; align-items: center; justify-content: space-between;
				padding: 0.45rem 1rem 0.35rem;
				border-bottom: 1px solid rgba(255,255,255,0.06); flex-shrink: 0;
			}
			.vp-title {
				font-size: 0.58rem; font-weight: 700; letter-spacing: 0.18em;
				text-transform: uppercase; color: rgba(255,255,255,0.28);
			}
			.vp-location {
				font-size: 0.62rem; color: rgba(255,255,255,0.38);
				overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 240px;
			}
			.vp-items { display: grid; grid-template-columns: repeat(4, 1fr); flex: 1; overflow: hidden; }
			.vp-item {
				display: flex; flex-direction: column; align-items: center; gap: 0.3rem;
				padding: 0.5rem 0.4rem; border-right: 1px solid rgba(212,175,55,0.35); overflow: hidden;
			}
			.vp-item:last-child { border-right: none; }
			.vp-thumb {
				width: 80px; height: 80px; border-radius: 6px; object-fit: cover;
				flex-shrink: 0; background: #0d1a2e; border: 1px solid rgba(212,175,55,0.6);
				box-sizing: border-box;
			}
			.vp-info { display: flex; flex-direction: column; align-items: center; gap: 0.05rem; overflow: hidden; min-width: 0; text-align: center; }
			.vp-name {
				font-size: 0.62rem; font-weight: 600; color: rgba(255,255,255,0.85);
				white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%;
			}
			.vp-type {
				font-size: 0.52rem; color: rgba(255,255,255,0.32);
				white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%;
			}
			.vp-alt { font-size: 0.54rem; color: rgba(100,200,255,0.65); font-family: monospace; }
			.vp-loading {
				grid-column: 1 / -1; display: flex; align-items: center; justify-content: center;
				font-size: 0.75rem; color: rgba(255,255,255,0.2);
			}

			#time-tip {
				display: none; align-items: center; gap: 0.6rem;
				background: rgba(255,193,60,0.12); border: 1px solid rgba(255,193,60,0.3);
				border-radius: 6px; padding: 0.55rem 1rem; margin-top: 0.75rem;
				font-size: 0.82rem; color: rgb(var(--gray-dark)); line-height: 1.5;
			}
			#time-tip.visible { display: flex; }
			.tip-icon { font-size: 1.1rem; flex-shrink: 0; }
			#dismiss-tip {
				margin-left: auto; background: none; border: none;
				cursor: pointer; color: rgb(var(--gray)); font-size: 1rem; line-height: 1;
			}
			#dismiss-tip:hover { color: rgb(var(--black)); }

			.sky-footer-note { font-size: 0.75rem; color: rgb(var(--gray)); text-align: center; padding: 0.75rem 0 2rem; }
			.sky-footer-note a { color: var(--accent); text-decoration: none; }
			.sky-footer-note a:hover { text-decoration: underline; }
		</style>
	</head>
	<body>
		<Header />
		<main class="sky-page">
			<div class="sky-header">
				<div class="sky-header-row">
					<h1 style="margin:0">🔭 Live Night Sky</h1>
					<button id="btn-change">← Change location</button>
				</div>
				<p>
					Real-time planetarium powered by <a href="https://stellarium-web.org" target="_blank" rel="noopener">Stellarium Web</a>.
					Drag to pan, scroll to zoom, click any object to identify it.
				</p>
			</div>

			<div id="location-prompt">
				<div class="prompt-icon">🌍</div>
				<h2>Where are you observing from?</h2>
				<p>Enter your city and we'll open the sky map and show what's visible tonight.</p>
				<div class="city-input-row">
					<input id="city-input" type="text" placeholder="e.g. Indore, Tokyo, New York…" autocomplete="off" spellcheck="false" />
					<button id="btn-go">Open Sky →</button>
				</div>
				<span id="location-status"></span>
			</div>

			<div class="sky-frame-wrap" id="sky-frame-wrap">
				<iframe id="stellarium-frame" title="Stellarium Live Planetarium" allowfullscreen></iframe>

				<div id="visible-panel">
					<div class="vp-header">
						<span class="vp-title">Visible Tonight</span>
						<span class="vp-location" id="vp-location"></span>
					</div>
					<div class="vp-items" id="vp-items">
						<div class="vp-loading">Calculating…</div>
					</div>
				</div>
			</div>

			<div id="time-tip">
				<span class="tip-icon">🕐</span>
				<span>
					If the time looks off, click the <strong>clock in the bottom-right corner</strong> of the sky view,
					then hit the <strong>↺ return to now</strong> button to sync it to your current time.
				</span>
				<button id="dismiss-tip" title="Dismiss">✕</button>
			</div>

			<p class="sky-footer-note">
				Powered by <a href="https://stellarium-web.org" target="_blank" rel="noopener">Stellarium Web</a>
				— open source planetarium software.
			</p>
		</main>
		<Footer />

		<script is:inline>
		(function () {
			// naked:true means visible to the unaided eye under reasonably
			// dark skies. Deep-sky objects that truly need binoculars or a
			// telescope (galaxies, faint nebulae, globular clusters) are
			// marked naked:false and excluded from this panel.
			var CATALOGUE = [
				{ name:'Moon', type:'Satellite', body:'Moon', img:'/sky/moon.jpg', naked:true },
				{ name:'Saturn', type:'Planet', body:'Saturn', img:'/sky/saturn.jpg', naked:true },
				{ name:'Jupiter', type:'Planet', body:'Jupiter', img:'/sky/jupiter.jpg', naked:true },
				{ name:'Mars', type:'Planet', body:'Mars', img:'/sky/mars.jpg', naked:true },
				{ name:'Venus', type:'Planet', body:'Venus', img:'/sky/venus.jpg', naked:true },
				{ name:'Mercury', type:'Planet', body:'Mercury', img:'/sky/mercury.jpg', naked:true },
				{ name:'Sirius', type:'Star', ra:6.7525, dec:-16.7161, img:'/sky/sirius.jpg', naked:true },
				{ name:'Orion Constellation', type:'Constellation', ra:5.9195, dec:7.4070, img:'/sky/orion-constellation.jpg', naked:true },
				{ name:'Pleiades', type:'Open Cluster', ra:3.7913, dec:24.1133, img:'/sky/pleiades.jpg', naked:true },
				{ name:'Orion Nebula', type:'Emission Nebula', ra:5.5880, dec:-5.3911, img:'/sky/orion-nebula.jpg', naked:false },
				{ name:'Andromeda Galaxy', type:'Galaxy', ra:0.7122, dec:41.2692, img:'/sky/andromeda.jpg', naked:false },
				{ name:'Ring Nebula', type:'Planetary Nebula', ra:18.8932, dec:33.0292, img:'/sky/ring-nebula.jpg', naked:false },
				{ name:'Whirlpool Galaxy', type:'Galaxy', ra:13.4979, dec:47.1953, img:'/sky/whirlpool.jpg', naked:false },
				{ name:'Crab Nebula', type:'Supernova Remnant', ra:5.5755, dec:22.0145, img:'/sky/crab-nebula.jpg', naked:false },
				{ name:'Lagoon Nebula', type:'Emission Nebula', ra:18.0603, dec:-24.3833, img:'/sky/lagoon-nebula.jpg', naked:false },
				{ name:'Omega Centauri', type:'Globular Cluster', ra:13.4464, dec:-47.4769, img:'/sky/omega-centauri.jpg', naked:false },
				{ name:'Sombrero Galaxy', type:'Galaxy', ra:12.6661, dec:-11.6231, img:'/sky/sombrero.jpg', naked:false },
				{ name:'Eta Carinae Nebula', type:'Emission Nebula', ra:10.7522, dec:-59.8678, img:'/sky/eta-carinae.jpg', naked:false },
			];

			function computeAltitude(obj, Astro, observer, now) {
				var altitude = -99;
				try {
					if (obj.body) {
						var eq = Astro.Equator(Astro.Body[obj.body], now, observer, true, true);
						altitude = Astro.Horizon(now, observer, eq.ra, eq.dec, 'normal').altitude;
					} else {
						altitude = Astro.Horizon(now, observer, obj.ra, obj.dec, 'normal').altitude;
					}
				} catch (e) { console.warn('alt calc failed for', obj.name, e); }
				return altitude;
			}

			// Priority order: naked-eye objects that are above the horizon
			// come first. Only if fewer than 4 of those are up do we fall
			// back and fill the remaining slots with binocular/telescope
			// objects, also sorted by altitude (highest = best placed).
			function computeVisible(lat, lng) {
				var Astro = window.Astronomy;
				if (!Astro) { console.warn('Astronomy Engine not loaded'); return []; }
				var observer = new Astro.Observer(lat, lng, 0);
				var now = new Date();

				var withAlt = CATALOGUE.map(function (obj) {
					return {
						name: obj.name,
						type: obj.type,
						img: obj.img,
						naked: obj.naked === true,
						altitude: computeAltitude(obj, Astro, observer, now),
					};
				});

				var aboveHorizon = withAlt.filter(function (o) { return o.altitude > 15; });

				var nakedUp = aboveHorizon
					.filter(function (o) { return o.naked; })
					.sort(function (a, b) { return b.altitude - a.altitude; });

				if (nakedUp.length >= 4) {
					return nakedUp.slice(0, 4);
				}

				var othersUp = aboveHorizon
					.filter(function (o) { return !o.naked; })
					.sort(function (a, b) { return b.altitude - a.altitude; });

				return nakedUp.concat(othersUp).slice(0, 4);
			}

			function renderPanel(objects, cityName) {
				var loc = document.getElementById('vp-location');
				var items = document.getElementById('vp-items');
				if (!loc || !items) return;
				loc.textContent = cityName;
				if (!objects.length) {
					items.innerHTML = '<div class="vp-loading">Nothing notable above horizon right now.</div>';
					return;
				}
				items.innerHTML = objects.map(function (o) {
					return '<div class="vp-item">' +
							'<img class="vp-thumb" src="' + o.img + '" alt="' + o.name + '" ' +
								'width="80" height="80" ' +
								'onerror="this.style.opacity=\'0.15\'" loading="lazy" />' +
							'<div class="vp-info">' +
								'<div class="vp-name">' + o.name + '</div>' +
								'<div class="vp-type">' + o.type + '</div>' +
								'<div class="vp-alt">' + o.altitude.toFixed(0) + '\u00b0 alt</div>' +
							'</div>' +
						'</div>';
				}).join('');
			}

			function waitForAstro(cb, tries) {
				tries = tries || 0;
				if (window.Astronomy) { cb(); return; }
				if (tries > 50) {
					console.error('Astronomy Engine failed to load after 5s');
					var items = document.getElementById('vp-items');
					if (items) {
						items.innerHTML = '<div class="vp-loading">Could not load sky data. Try refreshing.</div>';
					}
					return;
				}
				setTimeout(function () { waitForAstro(cb, tries + 1); }, 100);
			}

			function geocode(city) {
				return fetch('https://geocoding-api.open-meteo.com/v1/search?name=' + encodeURIComponent(city) + '&count=1&language=en&format=json')
					.then(function (res) { return res.json(); })
					.then(function (data) {
						if (!data.results || !data.results.length) throw new Error('not found');
						var r = data.results[0];
						var name = r.name + (r.country ? ', ' + r.country : '');
						return { lat: r.latitude, lng: r.longitude, name: name };
					});
			}

			function launch(lat, lng, name) {
				var frame = document.getElementById('stellarium-frame');
				var promptEl = document.getElementById('location-prompt');
				var frameWrap = document.getElementById('sky-frame-wrap');
				var btnChange = document.getElementById('btn-change');
				var timeTip = document.getElementById('time-tip');
				if (!frame) { console.error('stellarium-frame not found'); return; }

				frame.src = 'https://stellarium-web.org/?lat=' + lat.toFixed(5) + '&lng=' + lng.toFixed(5);
				promptEl.style.display  = 'none';
				frameWrap.style.display = 'block';
				btnChange.style.display = 'block';
				waitForAstro(function () {
					renderPanel(computeVisible(lat, lng), name);
				});
				setTimeout(function () { timeTip.classList.add('visible'); }, 3000);
			}

			function resetSkyPage() {
				var frame = document.getElementById('stellarium-frame');
				var promptEl = document.getElementById('location-prompt');
				var frameWrap = document.getElementById('sky-frame-wrap');
				var btnChange = document.getElementById('btn-change');
				var timeTip = document.getElementById('time-tip');
				var cityInput = document.getElementById('city-input');
				var statusEl = document.getElementById('location-status');
				var btnGo = document.getElementById('btn-go');
				var vpItems = document.getElementById('vp-items');
				if (!promptEl) return;

				frameWrap.style.display = 'none';
				promptEl.style.display  = 'flex';
				btnChange.style.display = 'none';
				timeTip.classList.remove('visible');
				frame.src = '';
				cityInput.value = '';
				statusEl.textContent = '';
				statusEl.className = '';
				btnGo.disabled = false;
				vpItems.innerHTML = '<div class="vp-loading">Calculating\u2026</div>';
			}

			function submitCity() {
				var cityInput = document.getElementById('city-input');
				var btnGo = document.getElementById('btn-go');
				var statusEl = document.getElementById('location-status');
				if (!cityInput) return;

				var city = cityInput.value.trim();
				if (!city) { cityInput.focus(); return; }
				btnGo.disabled = true;
				statusEl.className = '';
				statusEl.textContent = 'Looking up location\u2026';

				geocode(city).then(function (loc) {
					statusEl.className = 'success';
					statusEl.textContent = 'Found: ' + loc.name + ' \u2014 loading sky\u2026';
					setTimeout(function () { launch(loc.lat, loc.lng, loc.name); }, 600);
				}).catch(function (e) {
					console.error('Geocode failed:', e);
					statusEl.className = 'error';
					statusEl.textContent = 'City not found. Try a different name.';
					btnGo.disabled = false;
				});
			}

			// ── Event delegation: bind once on document, survives every ────
			// Astro view-transition body swap automatically. No re-binding,
			// no node cloning, no stale references possible.
			if (!window.__skyPageDelegated) {
				window.__skyPageDelegated = true;

				document.addEventListener('click', function (e) {
					var target = e.target;
					if (target && target.id === 'btn-go') { submitCity(); }
					if (target && target.id === 'btn-change') { resetSkyPage(); }
					if (target && target.id === 'dismiss-tip') {
						var tip = document.getElementById('time-tip');
						if (tip) tip.classList.remove('visible');
					}
				});

				document.addEventListener('keydown', function (e) {
					if (e.key === 'Enter' && e.target && e.target.id === 'city-input') {
						submitCity();
					}
				});
			}

			// Reset to a clean prompt state every time this page is (re)entered.
			function onEnterSkyPage() {
				if (document.getElementById('location-prompt')) {
					resetSkyPage();
					var cityInput = document.getElementById('city-input');
					if (cityInput) setTimeout(function () { cityInput.focus(); }, 50);
				}
			}

			onEnterSkyPage();
			document.addEventListener('astro:page-load', onEnterSkyPage);

			// ── bfcache fix ──────────────────────────────────────────────
			// Cross-origin iframes (like the Stellarium embed) usually don't
			// survive Chrome's back/forward cache restore — Stellarium's own
			// WebGL canvas and internal JS state get frozen and won't
			// reinitialize just by resetting the iframe's src. The reliable
			// fix is to force a full page reload when a bfcache restore is
			// detected via pageshow's `persisted` flag.
			window.addEventListener('pageshow', function (e) {
				if (e.persisted) {
					window.location.reload();
				}
			});
		})();
		</script>
	</body>
</html>