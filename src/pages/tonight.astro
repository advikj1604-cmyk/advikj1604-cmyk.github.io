---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Tonight's Sky — ${SITE_TITLE}`} description="Enter your location to find light pollution levels and what is visible tonight." />
    <style>
      .tonight-wrap { padding: 4rem 0 6rem; }
      .tonight-intro { margin-bottom: 3rem; }
      .tonight-intro h1 { font-family: var(--font-display); font-size: clamp(2rem,4vw,3rem); font-weight: 300; color: var(--star-white); margin: 1rem 0 1rem; }
      .tonight-intro p { color: var(--text-secondary); font-size: 0.95rem; line-height: 1.8; }
      .location-form { display: flex; gap: 0.75rem; margin-bottom: 2.5rem; flex-wrap: wrap; align-items: flex-end; }
      .location-input-wrap { flex: 1; min-width: 220px; }
      .location-label { font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--text-muted); display: block; margin-bottom: 0.5rem; }
      .location-input { width: 100%; background: rgba(13,20,36,0.7); border: 1px solid var(--border-subtle); color: var(--text-primary); font-family: var(--font-mono); font-size: 0.82rem; padding: 0.65em 1em; border-radius: 2px; outline: none; transition: border-color 0.2s; }
      .location-input:focus { border-color: var(--accent-cyan); }
      .location-input::placeholder { color: var(--text-muted); }
      .btn { background: transparent; border: 1px solid var(--accent-gold); color: var(--accent-gold); font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; padding: 0.7em 1.4em; border-radius: 2px; cursor: pointer; transition: all 0.2s; white-space: nowrap; }
      .btn:hover { background: rgba(200,169,110,0.1); color: var(--star-white); }
      .btn-secondary { border-color: var(--border-subtle); color: var(--text-muted); }
      .btn-secondary:hover { border-color: var(--accent-cyan); color: var(--accent-cyan); background: transparent; }
      .loading { display: none; font-family: var(--font-mono); font-size: 0.75rem; color: var(--accent-cyan); letter-spacing: 0.1em; padding: 1rem 0; }
      .loading.visible { display: block; }
      .error-msg { display: none; font-family: var(--font-mono); font-size: 0.75rem; color: var(--accent-rose); padding: 0.75rem 1rem; border: 1px solid rgba(224,112,133,0.2); border-radius: 2px; margin-bottom: 1.5rem; }
      .error-msg.visible { display: block; }
      #results { display: none; }
      #results.visible { display: block; }
      .result-location { margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border-subtle); }
      .result-city { font-family: var(--font-display); font-size: 1.8rem; font-weight: 300; color: var(--star-white); margin-bottom: 0.3rem; }
      .result-coords { font-family: var(--font-mono); font-size: 0.62rem; color: var(--text-muted); letter-spacing: 0.08em; }
      .stats-grid { display: grid; grid-template-columns: repeat(auto-fit,minmax(180px,1fr)); gap: 1px; background: var(--border-subtle); border: 1px solid var(--border-subtle); margin-bottom: 3rem; }
      .stat-card { background: var(--space-black); padding: 1.4rem 1.5rem; }
      .stat-label { font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.5rem; display: block; }
      .stat-value { font-family: var(--font-display); font-size: 1.6rem; font-weight: 300; line-height: 1.1; }
      .stat-sub { font-size: 0.78rem; color: var(--text-secondary); margin-top: 0.3rem; }
      .stat-link { font-family: var(--font-mono); font-size: 0.7rem; color: var(--accent-cyan); text-decoration: none; border-bottom: 1px solid rgba(79,195,247,0.3); }
      .stat-link:hover { color: var(--star-white); border-color: var(--star-white); }
      .b1,.b2{color:#4fc3f7} .b3,.b4{color:#a5d6a7} .b5{color:#fff176} .b6,.b7{color:#ffab91} .b8,.b9{color:#e57373}
      .section-header { font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 1.5rem; padding-bottom: 0.6rem; border-bottom: 1px solid var(--border-subtle); }
      .objects-grid { display: grid; grid-template-columns: repeat(auto-fill,minmax(260px,1fr)); gap: 1.5px; background: var(--border-subtle); border: 1px solid var(--border-subtle); margin-bottom: 3rem; }
      .object-card { background: var(--space-black); display: flex; flex-direction: column; overflow: hidden; transition: background 0.2s; }
      .object-card:hover { background: var(--space-navy); }
      .object-img { width: 100%; height: 140px; object-fit: cover; filter: brightness(0.8) saturate(0.85); display: block; }
      .object-img-fallback { width: 100%; height: 140px; background: linear-gradient(135deg,var(--space-navy),var(--nebula-blue)); display: flex; align-items: center; justify-content: center; font-size: 2.5rem; }
      .object-body { padding: 1.2rem; flex: 1; display: flex; flex-direction: column; gap: 0.3rem; }
      .object-name { font-family: var(--font-display); font-size: 1.1rem; font-weight: 300; color: var(--star-white); }
      .object-type { font-family: var(--font-mono); font-size: 0.58rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent-violet); }
      .object-desc { font-size: 0.8rem; color: var(--text-secondary); line-height: 1.65; flex: 1; }
      .object-footer { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.6rem; }
      .object-vis { display: inline-flex; align-items: center; font-family: var(--font-mono); font-size: 0.58rem; letter-spacing: 0.08em; text-transform: uppercase; padding: 0.2em 0.6em; border-radius: 2px; }
      .vis-naked { background: rgba(79,195,247,0.1); color: var(--accent-cyan); border: 1px solid rgba(79,195,247,0.2); }
      .vis-bino { background: rgba(200,169,110,0.1); color: var(--accent-gold); border: 1px solid rgba(200,169,110,0.2); }
      .vis-scope { background: rgba(156,111,228,0.1); color: var(--accent-violet); border: 1px solid rgba(156,111,228,0.2); }
      .object-time { font-family: var(--font-mono); font-size: 0.6rem; color: var(--text-muted); }
      .weather-bar { display: flex; gap: 1.5rem; flex-wrap: wrap; margin-bottom: 2rem; padding: 1.2rem 1.5rem; background: rgba(13,20,36,0.5); border: 1px solid var(--border-subtle); }
      .weather-item { display: flex; flex-direction: column; gap: 0.2rem; }
      .weather-label { font-family: var(--font-mono); font-size: 0.58rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); }
      .weather-value { font-family: var(--font-mono); font-size: 0.85rem; color: var(--text-primary); }
      @media(max-width:700px){.location-form{flex-direction:column}.objects-grid{grid-template-columns:1fr}}
    </style>
  </head>
  <body>
    <Header />
    <main>
      <div class="wide-wrapper tonight-wrap">
        <div class="tonight-intro">
          <span class="hero-eyebrow">✦ your sky tonight ✦</span>
          <h1>What can you see tonight?</h1>
          <p>Enter your city or use your location. The page calculates the Sun, Moon and planet positions for your exact location and date using the Astronomy Engine library, fetches live weather, and shows what's actually above your horizon tonight.</p>
        </div>
        <div class="location-form">
          <div class="location-input-wrap">
            <label class="location-label" for="city-input">City or place name</label>
            <input class="location-input" type="text" id="city-input" placeholder="e.g. Indore, Antarctica, Atacama..." autocomplete="off" />
          </div>
          <button class="btn" id="search-btn">Search</button>
          <button class="btn btn-secondary" id="locate-btn">Use my location</button>
        </div>
        <div class="loading" id="loading">Scanning the sky...</div>
        <div class="error-msg" id="error-msg"></div>
        <div id="results">
          <div class="result-location">
            <div class="result-city" id="result-city"></div>
            <div class="result-coords" id="result-coords"></div>
          </div>
          <p class="section-header">Conditions Tonight</p>
          <div class="weather-bar" id="weather-bar"></div>
          <p class="section-header">Light Pollution</p>
          <div class="stats-grid" id="stats-grid"></div>
          <p class="section-header" id="naked-header" style="margin-top:2.5rem;">Visible to the Naked Eye</p>
          <div class="objects-grid" id="naked-grid"></div>
          <p class="section-header" id="scope-header">Visible with Binoculars and Telescope</p>
          <div class="objects-grid" id="scope-grid"></div>
        </div>
      </div>
    </main>
    <Footer />

    <script>
      import * as Astronomy from 'astronomy-engine';

      const RISE = 1;
      const SET = -1;

      // ── Sky object catalog ───────────────────────────────────────────────
      // Solar-system bodies carry an Astronomy.Body — their real position is
      // computed for the search location and date. Stars / deep-sky objects
      // carry fixed J2000 right ascension (hours) / declination (degrees);
      // the small amount of precession since J2000 is negligible for
      // rise/set timing at the minute level.
      type SkyObject = {
        name: string; type: string; vis: 'naked'|'bino'|'scope'; minBortle: number;
        desc: string; img: string;
        body?: Astronomy.Body; ra?: number; dec?: number; special?: string;
      };

      const CATALOG: SkyObject[] = [
        { name:'The Moon', type:'Natural Satellite', vis:'naked', minBortle:9, body:Astronomy.Body.Moon,
          desc:'Even to the naked eye, maria and highland regions are distinct. Binoculars reveal hundreds of craters. Its phase and rise time shift noticeably from night to night.',
          img:'/sky/moon.jpg' },
        { name:'Venus', type:'Planet', vis:'naked', minBortle:9, body:Astronomy.Body.Venus,
          desc:'The brightest natural object after the Sun and Moon. Never strays far from the Sun — look near the horizon at dawn or dusk.',
          img:'/sky/venus.jpg' },
        { name:'Jupiter', type:'Planet', vis:'naked', minBortle:9, body:Astronomy.Body.Jupiter,
          desc:'Often the brightest star-like object in the sky. Four Galilean moons visible in binoculars. Cloud bands visible in a small telescope.',
          img:'/sky/jupiter.jpg' },
        { name:'Saturn', type:'Planet', vis:'naked', minBortle:9, body:Astronomy.Body.Saturn,
          desc:'Visible as a steady golden star. The rings are unmistakable even in a small telescope — never fails to astonish first-time viewers.',
          img:'/sky/saturn.jpg' },
        { name:'Mars', type:'Planet', vis:'naked', minBortle:9, body:Astronomy.Body.Mars,
          desc:'Unmistakable reddish-orange colour. Brightness varies dramatically — at opposition it rivals Jupiter.',
          img:'/sky/mars.jpg' },
        { name:'Mercury', type:'Planet', vis:'naked', minBortle:8, body:Astronomy.Body.Mercury,
          desc:'The innermost planet, always close to the Sun. Visible low on the horizon for short windows after sunset or before sunrise.',
          img:'/sky/mercury.jpg' },
        { name:'Sirius', type:'Star (brightest)', vis:'naked', minBortle:8, ra:6.7525, dec:-16.7161,
          desc:'The brightest star in the night sky, in Canis Major. Blue-white and brilliant, with a noticeable twinkle low on the horizon.',
          img:'/sky/sirius.jpg' },
        { name:'Orion Constellation', type:'Constellation', vis:'naked', minBortle:7, ra:5.9195, dec:7.4070,
          desc:'The hunter — one of the most recognisable star patterns. Three belt stars unmistakable. Betelgeuse (red supergiant) at one shoulder, Rigel (blue supergiant) at the foot.',
          img:'/sky/orion-constellation.jpg' },
        { name:'Pleiades (M45)', type:'Open Cluster', vis:'naked', minBortle:6, ra:3.7913, dec:24.1133,
          desc:'Six or more stars visible naked eye in good conditions. A beautiful binocular target revealing dozens of young blue stars in a tight group.',
          img:'/sky/pleiades.jpg' },
        { name:'Milky Way Core', type:'Galaxy', vis:'naked', minBortle:3, ra:17.7611, dec:-29.0078,
          desc:"Our galaxy's central band, centred near Sagittarius A*. In Bortle 1-3 skies it stretches across the sky and is bright enough to cast faint shadows. Only above the horizon for part of the year and part of the night.",
          img:'/sky/milky-way.jpg' },
        { name:'Zodiacal Light', type:'Atmospheric Phenomenon', vis:'naked', minBortle:2, special:'zodiacal',
          desc:'A faint pyramid of light extending from the horizon along the ecliptic, caused by sunlight scattering off interplanetary dust. Only visible from very dark, moonless sites.',
          img:'/sky/zodiacal.jpg' },
        { name:'Andromeda Galaxy (M31)', type:'Galaxy', vis:'bino', minBortle:5, ra:0.7122, dec:41.2692,
          desc:'Nearest major galaxy, 2.5 million light years away. Binoculars show its full oval extent, wider than six full Moons.',
          img:'/sky/andromeda.jpg' },
        { name:'Orion Nebula (M42)', type:'Emission Nebula', vis:'bino', minBortle:6, ra:5.5880, dec:-5.3911,
          desc:"A stellar nursery 1,344 light years away. Visible naked eye as a fuzzy star in Orion's sword. Binoculars reveal the glowing gas cloud and the Trapezium cluster.",
          img:'/sky/orion-nebula.jpg' },
        { name:'Beehive Cluster (M44)', type:'Open Cluster', vis:'bino', minBortle:6, ra:8.6734, dec:19.9814,
          desc:'A nearby open cluster in Cancer visible to the naked eye in dark skies. Binoculars resolve it into dozens of stars spread across a region wider than the Moon.',
          img:'/sky/beehive.jpg' },
        { name:'Double Cluster (NGC 869/884)', type:'Open Cluster', vis:'bino', minBortle:5, ra:2.3333, dec:57.1333,
          desc:'Two rich open clusters side by side in Perseus. Hundreds of young stars in a single binocular field of view — one of the finest sights in the northern sky.',
          img:'/sky/double-cluster.jpg' },
        { name:'Omega Centauri (NGC 5139)', type:'Globular Cluster', vis:'bino', minBortle:5, ra:13.4464, dec:-47.4769,
          desc:'The largest globular cluster in the Milky Way — 10 million stars in a ball 150 light years across. Best from the Southern Hemisphere.',
          img:'/sky/omega-centauri.jpg' },
        { name:'47 Tucanae (NGC 104)', type:'Globular Cluster', vis:'bino', minBortle:4, ra:0.4014, dec:-72.0806,
          desc:'The second brightest globular cluster, appearing next to the Small Magellanic Cloud. One million stars packed into a sphere 120 light years across.',
          img:'/sky/47tuc.jpg' },
        { name:'Ring Nebula (M57)', type:'Planetary Nebula', vis:'scope', minBortle:7, ra:18.8932, dec:33.0292,
          desc:"A dying star's expelled shell in Lyra. Even a small telescope reveals the distinctive smoke-ring shape around the central white dwarf.",
          img:'/sky/ring-nebula.jpg' },
        { name:'Whirlpool Galaxy (M51)', type:'Spiral Galaxy', vis:'scope', minBortle:4, ra:13.4979, dec:47.1953,
          desc:'A face-on spiral galaxy interacting with a companion. Long exposures reveal spiral arms. One of the most photographed deep sky objects.',
          img:'/sky/whirlpool.jpg' },
        { name:'Crab Nebula (M1)', type:'Supernova Remnant', vis:'scope', minBortle:5, ra:5.5755, dec:22.0145,
          desc:'Remnant of a supernova seen in 1054 AD, still expanding at 1,500 km/s. A telescope shows tangled glowing filaments powered by a central pulsar.',
          img:'/sky/crab-nebula.jpg' },
        { name:'Sombrero Galaxy (M104)', type:'Galaxy', vis:'scope', minBortle:4, ra:12.6661, dec:-11.6231,
          desc:'An edge-on spiral with a bright nucleus and a prominent dark dust lane. One of the most distinctive galaxy shapes in the Messier catalogue.',
          img:'/sky/sombrero.jpg' },
        { name:'Lagoon Nebula (M8)', type:'Emission Nebula', vis:'scope', minBortle:5, ra:18.0603, dec:-24.3833,
          desc:'A bright emission nebula and open cluster in Sagittarius. Visible to the naked eye from dark sites, stunning in a telescope with glowing gas clouds.',
          img:'/sky/lagoon-nebula.jpg' },
        { name:'Triangulum Galaxy (M33)', type:'Galaxy', vis:'scope', minBortle:3, ra:1.5642, dec:30.6602,
          desc:'The third largest galaxy in the Local Group at 2.7 million light years. Requires a very dark sky to see well — it covers an area larger than the full Moon.',
          img:'/sky/triangulum.jpg' },
        { name:'Eta Carinae Nebula', type:'Emission Nebula', vis:'scope', minBortle:4, ra:10.7522, dec:-59.8678,
          desc:'One of the largest and most luminous nebulae visible, in the Southern Hemisphere. Contains the unstable hypergiant star Eta Carinae, which may explode as a supernova.',
          img:'/sky/eta-carinae.jpg' },
      ];

      function getBortleInfo(b: number) {
        return [
          null,
          { label:'Exceptional Dark', sky:'Zodiacal light, gegenschein visible. Milky Way casts shadows.', limiting:'8.0 mag' },
          { label:'Truly Dark', sky:'M33 visible directly. Milky Way shows complex structure.', limiting:'7.5 mag' },
          { label:'Rural', sky:'Some horizon glow. Milky Way still shows fine detail.', limiting:'7.1 mag' },
          { label:'Rural/Suburban', sky:'Light domes on horizon. Milky Way impressive but washed overhead.', limiting:'6.8 mag' },
          { label:'Suburban', sky:'Milky Way visible but lacks contrast. Many Messier objects in binoculars.', limiting:'6.3 mag' },
          { label:'Bright Suburban', sky:'Milky Way near zenith only. Most Messier objects in telescope.', limiting:'5.9 mag' },
          { label:'Suburban/Urban', sky:'Milky Way invisible. Only bright clusters and doubles worthwhile.', limiting:'5.6 mag' },
          { label:'City', sky:'Only bright stars visible. Planets and Moon dominate.', limiting:'5.0 mag' },
          { label:'Inner City', sky:'About 20 stars visible. Sky is grey-orange, not black.', limiting:'4.5 mag' },
        ][Math.min(9, Math.max(1, b))];
      }

      // Population-based Bortle estimate. This is necessarily an
      // approximation — real light pollution depends on terrain, nearby
      // cities and lighting practices that population alone can't capture.
      function popToBortle(lat: number, lon: number, pop: number): number {
        const absLat = Math.abs(lat);
        // Known dark site regions — override population estimate
        if (absLat > 66) return 1;                                              // polar
        if (lat>-26&&lat<-18&&lon>-72&&lon<-65) return 1;                      // Atacama
        if (lat>32&&lat<35&&lon>76&&lon<80&&pop<5000) return 2;                // Ladakh/Hanle
        if (lat>31&&lat<33&&lon>77&&lon<79&&pop<15000) return 2;               // Spiti Valley
        if (lat>-35&&lat<-20&&lon>140&&lon<150&&pop<5000) return 2;            // Australian outback
        if (lat>18&&lat<32&&lon>0&&lon<35&&pop<10000) return 2;                // Sahara
        if (lat>42&&lat<50&&lon>90&&lon<118&&pop<20000) return 2;              // Mongolian steppe
        if (lat>35&&lat<42&&lon>-115&&lon<-105&&pop<10000) return 2;           // US high desert
        if (absLat>55&&pop<5000) return 2;                                      // remote high lat
        if (absLat>45&&pop<20000) return 3;                                     // remote mid lat
        // Population-based estimate
        if (pop === 0) return 3;
        if (pop < 1000) return 3;
        if (pop < 8000) return 4;
        if (pop < 30000) return 5;
        if (pop < 150000) return 6;
        if (pop < 700000) return 7;
        if (pop < 3000000) return 8;
        return 9;
      }


      // ── Astronomy Engine helpers ─────────────────────────────────────────

      function altDeg(time: Astronomy.AstroTime, ra: number, dec: number, observer: Astronomy.Observer): number {
        return Astronomy.Horizon(time, observer, ra, dec, 'normal').altitude;
      }

      // Binary-search refine a rise/set crossing between two times that
      // straddle altitude = 0.
      function bisectCrossing(t1: Astronomy.AstroTime, t2: Astronomy.AstroTime, ra: number, dec: number, observer: Astronomy.Observer): Astronomy.AstroTime {
        let a = t1, b = t2;
        for (let i = 0; i < 20; i++) {
          const mid = a.AddDays((b.ut - a.ut) / 2);
          const signA = altDeg(a, ra, dec, observer) >= 0 ? 1 : -1;
          const signM = altDeg(mid, ra, dec, observer) >= 0 ? 1 : -1;
          if (signA === signM) a = mid; else b = mid;
        }
        return a.AddDays((b.ut - a.ut) / 2);
      }

      // Finds the (first) continuous interval within [winStart, winEnd]
      // during which the object at (ra, dec) is above the horizon.
      // Returns null if it never rises above the horizon in that window.
      function findUpInterval(ra: number, dec: number, observer: Astronomy.Observer, winStart: Astronomy.AstroTime, winEnd: Astronomy.AstroTime): { start: Astronomy.AstroTime, end: Astronomy.AstroTime } | null {
        const stepDays = 6 / 1440; // 6-minute samples
        let t = winStart;
        let prevAlt = altDeg(t, ra, dec, observer);
        let start: Astronomy.AstroTime | null = prevAlt >= 0 ? winStart : null;
        let end: Astronomy.AstroTime | null = null;
        while (t.ut < winEnd.ut) {
          const remaining = winEnd.ut - t.ut;
          const next = t.AddDays(Math.min(stepDays, remaining));
          const alt = altDeg(next, ra, dec, observer);
          if (start === null && prevAlt < 0 && alt >= 0) {
            start = bisectCrossing(t, next, ra, dec, observer);
          } else if (start !== null && end === null && prevAlt >= 0 && alt < 0) {
            end = bisectCrossing(t, next, ra, dec, observer);
          }
          prevAlt = alt;
          t = next;
        }
        if (start !== null && end === null) end = winEnd;
        return start !== null ? { start, end } : null;
      }

      function getEquatorial(obj: SkyObject, observer: Astronomy.Observer, time: Astronomy.AstroTime): { ra: number, dec: number } {
        if (obj.body !== undefined) {
          const eq = Astronomy.Equator(obj.body, time, observer, true, true);
          return { ra: eq.ra, dec: eq.dec };
        }
        return { ra: obj.ra!, dec: obj.dec! };
      }

      // Works out tonight's dusk→dawn window and the astronomical-twilight
      // ("truly dark") window around the current moment.
      function getNightWindow(observer: Astronomy.Observer, now: Astronomy.AstroTime) {
        const Sun = Astronomy.Body.Sun;
        const nextRise = Astronomy.SearchRiseSet(Sun, observer, RISE, now, 2);
        const nextSet = Astronomy.SearchRiseSet(Sun, observer, SET, now, 2);

        let nightStart: Astronomy.AstroTime | null = null;
        let nightEnd: Astronomy.AstroTime | null = null;

        if (nextRise && nextSet && nextRise.ut < nextSet.ut) {
          // It's currently night — the Sun rises before it next sets.
          nightEnd = nextRise;
          nightStart = Astronomy.SearchRiseSet(Sun, observer, SET, now.AddDays(-1), 1.5);
        } else if (nextSet) {
          nightStart = nextSet;
          nightEnd = Astronomy.SearchRiseSet(Sun, observer, RISE, nextSet, 1.5);
        }

        if (!nightStart || !nightEnd) {
          // Polar day/night — fall back to a 24h window from now.
          nightStart = now;
          nightEnd = now.AddDays(1);
        }

        let darkStart = Astronomy.SearchAltitude(Sun, observer, SET, nightStart, 1, -18) ?? nightStart;
        let darkEnd = Astronomy.SearchAltitude(Sun, observer, RISE, darkStart, 1, -18) ?? nightEnd;
        if (darkStart.ut < nightStart.ut) darkStart = nightStart;
        if (darkStart.ut > nightEnd.ut) darkStart = nightEnd;
        if (darkEnd.ut > nightEnd.ut) darkEnd = nightEnd;
        if (darkEnd.ut < darkStart.ut) darkEnd = darkStart;

        return { nightStart, nightEnd, darkStart, darkEnd };
      }

      function moonPhaseName(angle: number): string {
        const a = ((angle % 360) + 360) % 360;
        if (a < 22.5 || a >= 337.5) return 'New Moon';
        if (a < 67.5) return 'Waxing Crescent';
        if (a < 112.5) return 'First Quarter';
        if (a < 157.5) return 'Waxing Gibbous';
        if (a < 202.5) return 'Full Moon';
        if (a < 247.5) return 'Waning Gibbous';
        if (a < 292.5) return 'Last Quarter';
        return 'Waning Crescent';
      }

      // Renders an AstroTime as a local clock time using a UTC offset in
      // seconds (so half-hour/quarter-hour timezones work correctly).
      function fmtTime(t: Astronomy.AstroTime, tzOffsetSec: number): string {
        const d = new Date(t.date.getTime() + tzOffsetSec * 1000);
        let h = d.getUTCHours();
        const m = d.getUTCMinutes();
        const ampm = h >= 12 ? 'PM' : 'AM';
        h = h % 12 || 12;
        return `${h}:${m.toString().padStart(2,'0')} ${ampm}`;
      }

      function renderCard(obj: SkyObject, up: { start: Astronomy.AstroTime, end: Astronomy.AstroTime } | null, tzOffsetSec: number, mag: number | null): string {
        const visClass = obj.vis==='naked'?'vis-naked':obj.vis==='bino'?'vis-bino':'vis-scope';
        const visLabel = obj.vis==='naked'?'Naked Eye':obj.vis==='bino'?'Binoculars':'Telescope';
        const windowText = (obj.special === 'zodiacal' || !up)
          ? '~80 min after dusk or before dawn, near horizon'
          : `${fmtTime(up.start,tzOffsetSec)} – ${fmtTime(up.end,tzOffsetSec)}`;
        const magText = (mag !== null && mag !== undefined) ? ` · mag ${mag.toFixed(1)}` : '';
        return `
          <div class="object-card">
            <img class="object-img" src="${obj.img}" alt="${obj.name}" loading="lazy"
              onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"/>
            <div class="object-img-fallback" style="display:none">✦</div>
            <div class="object-body">
              <div class="object-name">${obj.name}</div>
              <div class="object-type">${obj.type}${magText}</div>
              <div class="object-desc">${obj.desc}</div>
              <div class="object-footer">
                <span class="object-vis ${visClass}">${visLabel}</span>
                <span class="object-time">Visible: ${windowText}</span>
              </div>
            </div>
          </div>`;
      }

      // ── DOM ──────────────────────────────────────────────────────────────
      const cityInput = document.getElementById('city-input') as HTMLInputElement;
      const searchBtn = document.getElementById('search-btn')!;
      const locateBtn = document.getElementById('locate-btn')!;
      const loadingEl = document.getElementById('loading')!;
      const errorEl   = document.getElementById('error-msg')!;
      const resultsEl = document.getElementById('results')!;

      function showLoading(msg='Scanning the sky...') {
        loadingEl.textContent=msg; loadingEl.classList.add('visible');
        errorEl.classList.remove('visible'); resultsEl.classList.remove('visible');
      }
      function hideLoading() { loadingEl.classList.remove('visible'); }
      function showError(msg: string) { hideLoading(); errorEl.textContent=msg; errorEl.classList.add('visible'); }

      async function geocode(city: string) {
        const r = await fetch(`https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(city)}&count=1&language=en&format=json`);
        const d = await r.json();
        if (!d.results?.length) return null;
        const x = d.results[0];
        return { lat:x.latitude, lon:x.longitude, name:x.name, country:x.country??'', admin:x.admin1??'', population:x.population??0 };
      }

      async function renderResults(lat: number, lon: number, cityName: string, country: string, population: number = 0) {
        try {
          showLoading('Fetching weather and computing tonight\'s sky...');
          const weather = await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&daily=precipitation_probability_max,cloudcover_mean&current_weather=true&forecast_days=1&timezone=auto`).then(r => r.json());

          const tzOffsetSec: number = weather.utc_offset_seconds ?? Math.round(lon / 15) * 3600;
          const bortle = popToBortle(lat, lon, population);
          const info = getBortleInfo(bortle)!;
          const cloud = weather.daily?.cloudcover_mean?.[0] ?? 50;
          const temp = weather.current_weather?.temperature ?? 'N/A';
          const wind = weather.current_weather?.windspeed ?? 'N/A';
          const precip = weather.daily?.precipitation_probability_max?.[0] ?? 'N/A';
          const skyQ = cloud<20?'Clear':cloud<50?'Partly Cloudy':cloud<80?'Mostly Cloudy':'Overcast';
          const skyC = cloud<20?'var(--accent-cyan)':cloud<50?'var(--accent-gold)':'var(--accent-rose)';

          // ── Astronomy Engine: compute tonight's sky for this place/date ──
          const observer = new Astronomy.Observer(lat, lon, 0);
          const now = Astronomy.MakeTime(new Date());
          const { nightStart, nightEnd, darkStart, darkEnd } = getNightWindow(observer, now);
          const midTime = nightStart.AddDays((nightEnd.ut - nightStart.ut) / 2);

          // Moon phase + whether bright moonlight will be up during dark hours
          const moonIllum = Astronomy.Illumination(Astronomy.Body.Moon, now);
          const moonAngle = Astronomy.MoonPhase(now);
          const moonPct = Math.round(moonIllum.phase_fraction * 100);
          const moonName = moonPhaseName(moonAngle);
          const moonEq = Astronomy.Equator(Astronomy.Body.Moon, midTime, observer, true, true);
          const moonUpDuringDark = darkEnd.ut > darkStart.ut
            ? findUpInterval(moonEq.ra, moonEq.dec, observer, darkStart, darkEnd)
            : null;
          const moonPenalty = (moonUpDuringDark && moonPct > 65) ? 2 : (moonUpDuringDark && moonPct > 35 ? 1 : 0);
          const effectiveBortle = Math.min(9, bortle + moonPenalty);

          document.getElementById('result-city')!.textContent = `${cityName}${country?', '+country:''}`;
          document.getElementById('result-coords')!.textContent = `${lat.toFixed(4)}°, ${lon.toFixed(4)}°`;

          const darkText = darkEnd.ut > darkStart.ut
            ? `${fmtTime(darkStart,tzOffsetSec)} – ${fmtTime(darkEnd,tzOffsetSec)}`
            : 'No true darkness tonight';

          document.getElementById('weather-bar')!.innerHTML = `
            <div class="weather-item"><span class="weather-label">Sky Tonight </span><span class="weather-value" style="color:${skyC}">${skyQ}</span></div>
            <div class="weather-item"><span class="weather-label">Cloud Cover </span><span class="weather-value" style="color:${skyC}">${Math.round(cloud)}%</span></div>
            <div class="weather-item"><span class="weather-label">Temperature </span><span class="weather-value" style="color:${skyC}">${temp}°C</span></div>
            <div class="weather-item"><span class="weather-label">Wind </span><span class="weather-value" style="color:${skyC}">${wind} km/h</span></div>
            <div class="weather-item"><span class="weather-label">Rain Chance </span><span class="weather-value" style="color:${skyC}">${precip}%</span></div>
            <div class="weather-item"><span class="weather-label">Sunset → Sunrise </span><span class="weather-value" style="color:${skyC}">${fmtTime(nightStart,tzOffsetSec)} – ${fmtTime(nightEnd,tzOffsetSec)}</span></div>
            <div class="weather-item"><span class="weather-label">Astronomical Dark </span><span class="weather-value" style="color:${skyC}">${darkText}</span></div>
            <div class="weather-item"><span class="weather-label">Moon Tonight </span><span class="weather-value" style="color:${skyC}">${moonName} (${moonPct}%)${moonUpDuringDark?'':' · below horizon'}</span></div>
            <div class="weather-item"><span class="weather-label">Best Viewing </span><span class="weather-value" style="color:var(--accent-gold)">${cloud<30 && moonPenalty===0?'Good tonight':cloud<60?'Partly usable':'Poor conditions'}</span></div>`;
          const lpLink = `https://lightpollutionmap.app/?lat=${lat.toFixed(4)}&lng=${lon.toFixed(4)}&zoom=8`;
          document.getElementById('stats-grid')!.innerHTML = `
            <div class="stat-card"><span class="stat-label">Bortle Class (estimated)</span><div class="stat-value b${bortle}">${bortle} / 9</div><div class="stat-sub">${info.label}</div></div>
            <div class="stat-card"><span class="stat-label">Sky Description</span><div style="font-size:0.85rem;color:var(--text-secondary);margin-top:0.4rem;line-height:1.6">${info.sky}</div></div>
            <div class="stat-card"><span class="stat-label">Limiting Magnitude</span><div class="stat-value" style="color:var(--accent-cyan)">${info.limiting}</div><div class="stat-sub">${moonPenalty>0?'Worse tonight — moonlight raises the sky background':'Faintest naked eye star'}</div></div>
            <div class="stat-card"><span class="stat-label">Verify Your Sky</span><div style="margin-top:0.6rem"><a class="stat-link" href="${lpLink}" target="_blank" rel="noopener">Open a detailed light-pollution map →</a></div><div class="stat-sub" style="margin-top:0.6rem">This Bortle class is estimated from population data — the map above uses real satellite light data for your exact spot.</div></div>`;

          // ── Build tonight's object lists from real positions ─────────────
          type Entry = { obj: SkyObject, up: { start: Astronomy.AstroTime, end: Astronomy.AstroTime } | null, mag: number | null };
          const naked: Entry[] = [];
          const rest: Entry[] = [];

          for (const obj of CATALOG) {
            if (obj.special === 'zodiacal') {
              if (effectiveBortle <= obj.minBortle) naked.push({ obj, up: null, mag: null });
              continue;
            }
            const { ra, dec } = getEquatorial(obj, observer, midTime);
            const up = findUpInterval(ra, dec, observer, nightStart, nightEnd);
            if (!up) continue; // below the horizon all night — not visible tonight

            // Faint targets (minBortle <= 6) are also hurt by moonlight.
            const limit = obj.minBortle <= 6 ? effectiveBortle : bortle;
            if (limit > obj.minBortle) continue;

            let mag: number | null = null;
            if (obj.body !== undefined && obj.body !== Astronomy.Body.Moon) {
              mag = Astronomy.Illumination(obj.body, midTime).mag;
            }
            (obj.vis === 'naked' ? naked : rest).push({ obj, up, mag });
          }

          document.getElementById('naked-header')!.textContent = `Visible to the Naked Eye (${naked.length} object${naked.length!==1?'s':''})`;
          document.getElementById('naked-grid')!.innerHTML = naked.map(({obj,up,mag}) => renderCard(obj,up,tzOffsetSec,mag)).join('')
            || '<p style="color:var(--text-muted);font-family:var(--font-mono);font-size:0.8rem;padding:1rem">Nothing on the naked-eye list clears the horizon and your sky brightness tonight.</p>';
          document.getElementById('scope-header')!.textContent = `Binoculars and Telescope (${rest.length} object${rest.length!==1?'s':''})`;
          document.getElementById('scope-grid')!.innerHTML = rest.map(({obj,up,mag}) => renderCard(obj,up,tzOffsetSec,mag)).join('')
            || '<p style="color:var(--text-muted);font-family:var(--font-mono);font-size:0.8rem;padding:1rem">Nothing on this list clears the horizon and your sky brightness tonight.</p>';

          hideLoading(); resultsEl.classList.add('visible');
        } catch(e) {
          console.error('Sky data error:', e);
          showError('Could not compute sky data. Check console for details.');
        }
      }

      searchBtn.addEventListener('click', async () => {
        const city = cityInput.value.trim();
        if (!city) return;
        showLoading('Looking up location...');
        const geo = await geocode(city);
        if (!geo) { showError(`Could not find "${city}". Try a different spelling.`); return; }
        await renderResults(geo.lat, geo.lon, geo.name, geo.country, geo.population);
      });

      cityInput.addEventListener('keydown', e => { if(e.key==='Enter') searchBtn.click(); });

      locateBtn.addEventListener('click', () => {
        if (!navigator.geolocation) { showError('Geolocation not supported.'); return; }
        showLoading('Getting your location...');
        navigator.geolocation.getCurrentPosition(
          async p => await renderResults(p.coords.latitude, p.coords.longitude, 'Your Location', ''),
          () => showError('Location access denied. Please type your city.')
        );
      });
    </script>
  </body>
</html>